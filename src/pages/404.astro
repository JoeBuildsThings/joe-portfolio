---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Adebiyi Joseph Ayomide"
  description="This page does not exist. Head back to the portfolio of Adebiyi Joseph Ayomide."
>
  <main class="mx-auto max-w-3xl px-6 pt-32 pb-24">
    <h1 class="font-display text-4xl font-semibold">That page does not exist</h1>
    <p class="mt-4 text-text-muted">The link may be old or mistyped.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-accent px-5 py-3 font-medium text-bg transition-colors hover:bg-accent-deep"
    >
      Back to the portfolio
    </a>
  </main>
</BaseLayout>
